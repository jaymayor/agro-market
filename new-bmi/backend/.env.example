NODE_ENV=development
PORT=5000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/agro_market?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# SMS (Eskiz.uz)
SMS_EMAIL=your@email.com
SMS_PASSWORD=your_sms_password
SMS_FROM=4546

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# CORS
CLIENT_URL=http://localhost:3000
