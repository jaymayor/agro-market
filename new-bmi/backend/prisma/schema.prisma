generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  moderator
  seller
  buyer
  delivery_man
}

enum UserStatus {
  active
  suspended
  banned
}

enum ShopStatus {
  pending
  active
  suspended
  closed
}

enum ProductUnit {
  kg
  gramm
  tonna
  litr
  dona
  quti
}

enum ProductStatus {
  draft
  pending
  active
  rejected
  hidden
  expired
  out_of_stock
}

enum OrderStatus {
  new
  pre_order
  confirmed
  preparing
  shipped
  delivered
  completed
  cancelled
}

enum OrderType {
  standard
  pre_order
}

enum PaymentMethod {
  click
  payme
  uzcard
  cash
  card
}

enum PaymentStatus {
  pending
  initiated
  processing
  paid
  failed
  refunded
  partial_refunded
  expired
}

enum DeliveryType {
  seller_delivery
  platform_delivery
  pickup
}

enum DeliveryStatus {
  pending
  assigned
  picked_up
  in_transit
  arrived
  delivered
  failed
}

enum ComplaintType {
  product_quality
  wrong_product
  wrong_quantity
  not_delivered
  late_delivery
  payment_issue
  seller_fraud
}

enum ComplaintStatus {
  open
  seller_responded
  disputed
  refund_agreed
  refund_approved
  closed_no_refund
  closed
}

enum RefundType {
  full
  partial
  none
}

enum WalletTxType {
  credit
  debit
  refund_debit
  commission
}

enum WithdrawalStatus {
  pending
  processing
  completed
  rejected
}

enum NotifChannel {
  in_app
  sms
  push
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id                String      @id @default(uuid())
  phone             String      @unique
  full_name         String?
  email             String?     @unique
  role              Role        @default(buyer)
  status            UserStatus  @default(active)
  is_verified       Boolean     @default(false)
  avatar_url        String?
  is_first_login    Boolean     @default(true)
  otp_attempts      Int         @default(0)
  otp_blocked_until DateTime?
  warning_count     Int         @default(0)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  shop              Shop?
  orders            Order[]              @relation("BuyerOrders")
  reviews           Review[]
  notifications     Notification[]
  refresh_tokens    RefreshToken[]
  complaints        Complaint[]
  delivered_orders  DeliveryOrder[]      @relation("DriverDeliveries")
  moderated_complaints Complaint[]       @relation("ModeratorComplaints")
  cancelled_orders  Order[]              @relation("CancelledBy")
  processed_withdrawals WithdrawalRequest[] @relation("ProcessedBy")
  wallet_transactions WalletTransaction[] @relation("AdminTransactions")

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  token_hash  String   @unique
  expires_at  DateTime
  is_revoked  Boolean  @default(false)
  device_info Json     @default("{}")
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model Shop {
  id              String     @id @default(uuid())
  owner_id        String     @unique
  name            String
  slug            String     @unique
  description     String?
  logo_url        String?
  banner_url      String?
  region          String
  district        String
  address         String
  lat             Decimal?   @db.Decimal(9, 6)
  lng             Decimal?   @db.Decimal(9, 6)
  status          ShopStatus @default(pending)
  rating          Decimal    @default(0.00) @db.Decimal(3, 2)
  total_sales     Int        @default(0)
  commission_rate Decimal    @default(5.00) @db.Decimal(5, 2)
  is_verified     Boolean    @default(false)
  warning_count   Int        @default(0)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  owner       User               @relation(fields: [owner_id], references: [id])
  products    Product[]
  orders      Order[]
  wallet      SellerWallet?
  withdrawals WithdrawalRequest[]

  @@index([status])
  @@map("shops")
}

model Category {
  id        String     @id @default(uuid())
  name_uz   String
  name_ru   String?
  slug      String     @unique
  parent_id String?
  icon_url  String?
  ordering  Int        @default(0)
  is_active Boolean    @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id                  String        @id @default(uuid())
  shop_id             String
  category_id         String?
  name_uz             String
  name_ru             String?
  description_uz      String
  description_ru      String?
  price               Decimal       @db.Decimal(12, 2)
  discount_price      Decimal?      @db.Decimal(12, 2)
  unit                ProductUnit   @default(kg)
  min_order_qty       Decimal       @default(1) @db.Decimal(10, 2)
  stock_qty           Decimal       @default(0) @db.Decimal(10, 2)

  // Ayniydigan mahsulot
  is_perishable       Boolean       @default(false)
  shelf_life_days     Int?
  storage_temp_min    Decimal?      @db.Decimal(4, 1)
  storage_temp_max    Decimal?      @db.Decimal(4, 1)
  requires_cold_chain Boolean       @default(false)
  harvest_date        DateTime?     @db.Date
  expiry_date         DateTime?     @db.Date
  max_preorder_days   Int           @default(0)
  low_stock_alert_qty Decimal       @default(0) @db.Decimal(10, 2)

  origin_region       String?
  is_organic          Boolean       @default(false)
  status              ProductStatus @default(pending)
  rejection_reason    String?
  rating              Decimal       @default(0.00) @db.Decimal(3, 2)
  views_count         Int           @default(0)
  sales_count         Int           @default(0)
  slug                String        @unique
  is_deleted          Boolean       @default(false)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  shop        Shop           @relation(fields: [shop_id], references: [id])
  category    Category?      @relation(fields: [category_id], references: [id])
  images      ProductImage[]
  cart_items  CartItem[]
  order_items OrderItem[]
  reviews     Review[]

  @@index([shop_id, status])
  @@index([category_id, status])
  @@index([is_deleted])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  product_id String
  url        String
  is_main    Boolean  @default(false)
  ordering   Int      @default(0)
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_images")
}

model Cart {
  id         String     @id @default(uuid())
  user_id    String     @unique
  expires_at DateTime
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid())
  cart_id        String
  product_id     String
  quantity        Decimal  @db.Decimal(10, 2)
  price_snapshot Decimal  @db.Decimal(12, 2)
  added_at       DateTime @default(now())

  cart    Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])
  @@map("cart_items")
}

model Order {
  id                    String        @id @default(uuid())
  order_number          String        @unique
  buyer_id              String
  shop_id               String
  status                OrderStatus   @default(new)
  type                  OrderType     @default(standard)
  subtotal              Decimal       @db.Decimal(12, 2)
  delivery_fee          Decimal       @default(0) @db.Decimal(10, 2)
  total_amount          Decimal       @db.Decimal(12, 2)
  platform_commission   Decimal       @default(0) @db.Decimal(10, 2)
  seller_amount         Decimal       @default(0) @db.Decimal(10, 2)
  payment_method        PaymentMethod
  payment_status        PaymentStatus @default(pending)
  delivery_type         DeliveryType  @default(seller_delivery)
  delivery_address      Json
  delivery_zone_id      String?
  expected_delivery_date DateTime?    @db.Date
  actual_delivery_date  DateTime?     @db.Date
  notes                 String?
  cancel_reason         String?
  cancelled_by_id       String?
  pre_order_harvest_date DateTime?    @db.Date
  delivered_at          DateTime?
  auto_complete_at      DateTime?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  buyer          User              @relation("BuyerOrders", fields: [buyer_id], references: [id])
  shop           Shop              @relation(fields: [shop_id], references: [id])
  cancelled_by   User?             @relation("CancelledBy", fields: [cancelled_by_id], references: [id])
  delivery_zone  DeliveryZone?     @relation(fields: [delivery_zone_id], references: [id])
  items          OrderItem[]
  payment        Payment?
  delivery       DeliveryOrder?
  status_history OrderStatusHistory[]
  complaints     Complaint[]

  @@index([buyer_id, status])
  @@index([shop_id, status])
  @@map("orders")
}

model OrderItem {
  id                    String   @id @default(uuid())
  order_id              String
  product_id            String
  product_name_snapshot String
  quantity              Decimal  @db.Decimal(10, 2)
  unit_price            Decimal  @db.Decimal(12, 2)
  total_price           Decimal  @db.Decimal(12, 2)
  created_at            DateTime @default(now())

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  order_id    String
  from_status String?
  to_status   String
  changed_by  String
  reason      String?
  created_at  DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

model Payment {
  id                    String        @id @default(uuid())
  order_id              String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  provider              PaymentMethod
  provider_transaction_id String?
  provider_payment_url  String?
  status                PaymentStatus @default(pending)
  raw_response          Json?
  idempotency_key       String        @unique
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  order Order @relation(fields: [order_id], references: [id])

  @@map("payments")
}

model SellerWallet {
  id               String   @id @default(uuid())
  shop_id          String   @unique
  balance          Decimal  @default(0) @db.Decimal(12, 2)
  pending_balance  Decimal  @default(0) @db.Decimal(12, 2)
  total_earned     Decimal  @default(0) @db.Decimal(12, 2)
  total_withdrawn  Decimal  @default(0) @db.Decimal(12, 2)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  shop         Shop                @relation(fields: [shop_id], references: [id])
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  @@map("seller_wallets")
}

model WalletTransaction {
  id          String       @id @default(uuid())
  wallet_id   String
  type        WalletTxType
  amount      Decimal      @db.Decimal(12, 2)
  order_id    String?
  description String?
  created_by  String?
  created_at  DateTime     @default(now())

  wallet      SellerWallet @relation(fields: [wallet_id], references: [id])
  admin       User?        @relation("AdminTransactions", fields: [created_by], references: [id])

  @@index([wallet_id])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id           String           @id @default(uuid())
  shop_id      String
  wallet_id    String
  amount       Decimal          @db.Decimal(12, 2)
  bank_details Json
  status       WithdrawalStatus @default(pending)
  admin_note   String?
  processed_by_id String?
  created_at   DateTime         @default(now())
  processed_at DateTime?

  shop         Shop         @relation(fields: [shop_id], references: [id])
  wallet       SellerWallet @relation(fields: [wallet_id], references: [id])
  processed_by User?        @relation("ProcessedBy", fields: [processed_by_id], references: [id])

  @@map("withdrawal_requests")
}

model DeliveryZone {
  id                       String   @id @default(uuid())
  name                     String
  region                   String
  district                 String
  base_fee                 Decimal  @db.Decimal(10, 2)
  per_km_fee               Decimal  @default(0) @db.Decimal(10, 2)
  min_order_free_delivery  Decimal? @db.Decimal(12, 2)
  max_delivery_days        Int      @default(3)
  is_cold_chain_available  Boolean  @default(false)
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  orders Order[]

  @@map("delivery_zones")
}

model DeliveryOrder {
  id                  String         @id @default(uuid())
  order_id            String         @unique
  driver_id           String?
  status              DeliveryStatus @default(pending)
  current_lat         Decimal?       @db.Decimal(9, 6)
  current_lng         Decimal?       @db.Decimal(9, 6)
  pickup_photo_url    String?
  delivery_photo_url  String?
  picked_up_at        DateTime?
  delivered_at        DateTime?
  failed_reason       String?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  order  Order @relation(fields: [order_id], references: [id])
  driver User? @relation("DriverDeliveries", fields: [driver_id], references: [id])

  @@map("delivery_orders")
}

model Complaint {
  id                 String          @id @default(uuid())
  order_id           String
  buyer_id           String
  type               ComplaintType
  description        String
  status             ComplaintStatus @default(open)
  refund_amount      Decimal?        @db.Decimal(12, 2)
  refund_type        RefundType?
  moderator_id       String?
  moderator_decision String?
  seller_response    String?
  resolved_at        DateTime?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  order      Order               @relation(fields: [order_id], references: [id])
  buyer      User                @relation(fields: [buyer_id], references: [id])
  moderator  User?               @relation("ModeratorComplaints", fields: [moderator_id], references: [id])
  evidences  ComplaintEvidence[]

  @@index([order_id])
  @@index([status])
  @@map("complaints")
}

model ComplaintEvidence {
  id           String   @id @default(uuid())
  complaint_id String
  uploaded_by  String
  file_url     String
  file_type    String
  created_at   DateTime @default(now())

  complaint Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  @@map("complaint_evidences")
}

model Review {
  id           String   @id @default(uuid())
  order_id     String
  user_id      String
  product_id   String
  rating       Int
  comment      String?
  images       Json     @default("[]")
  seller_reply String?
  is_hidden    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([order_id, product_id])
  @@index([product_id])
  @@map("reviews")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  title      String
  body       String
  data       Json     @default("{}")
  is_read    Boolean  @default(false)
  channels   Json     @default("[]")
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model DevOtpLog {
  id         String   @id @default(uuid())
  phone      String
  otp        String
  created_at DateTime @default(now())

  @@map("dev_otp_logs")
}
